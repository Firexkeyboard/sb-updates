<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>RuriLib</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>True</UseWPF>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- This is a Windows-only WPF app; all Windows-specific API calls are intentional -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <!-- Proyecto interno -->
  <ItemGroup>
    <ProjectReference Include="..\SilverBullet.ImageProcessor\SilverBullet.ImageProcessor.csproj" />
  </ItemGroup>

  <!-- Paquetes NuGet (versiones exactas de las DLLs originales) -->
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="LiteDB" Version="5.0.17" />
    <PackageReference Include="AngleSharp" Version="1.1.2" />
    <PackageReference Include="Jint" Version="2.11.58" />
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
    <PackageReference Include="Humanizer" Version="2.14.1" />
    <PackageReference Include="IronPython" Version="3.4.1" />
    <PackageReference Include="Telegram.Bot" Version="19.0.0" />
    <PackageReference Include="Selenium.WebDriver" Version="4.25.0" />
    <PackageReference Include="Selenium.Support" Version="4.25.0" />
    <PackageReference Include="WebDriverManager" Version="2.17.4" />
    <PackageReference Include="CaptchaSharp" Version="1.0.13" />
    <PackageReference Include="CaptchaSharp.Services.More" Version="1.0.6" />
    <PackageReference Include="CloudflareSolverRe" Version="1.0.6" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="6.32.0" />
    <PackageReference Include="SVG" Version="3.4.6" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <PackageReference Include="Microsoft.CodeDom.Providers.DotNetCompilerPlatform" Version="4.1.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="4.9.2" />
    <PackageReference Include="MoonSharp" Version="2.0.0" />
    <PackageReference Include="Scrypt.NET" Version="1.3.0" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="WebSocketSharp-netstandard" Version="1.0.1" />
  </ItemGroup>

  <!-- DLLs sin equivalente NuGet compatible — mantener como HintPath -->
  <ItemGroup>
    <!-- HashLib: sin versión .NET 8 en NuGet; pendiente migrar a HashLib4Pascal u otra -->
    <Reference Include="HashLib">
      <HintPath>..\..\Telegram Desktop\SilverBullet.v1.1.4 Re-upload\SilverBullet.v1.1.4 Re-upload\bin\HashLib.dll</HintPath>
    </Reference>
    <!-- CryptSharp: API distinta en versiones NuGet modernas -->
    <Reference Include="CryptSharp">
      <HintPath>..\..\Telegram Desktop\SilverBullet.v1.1.4 Re-upload\SilverBullet.v1.1.4 Re-upload\bin\CryptSharp.dll</HintPath>
    </Reference>
    <!-- PluginFramework: sin source disponible -->
    <Reference Include="PluginFramework">
      <HintPath>..\..\Telegram Desktop\SilverBullet.v1.1.4 Re-upload\SilverBullet.v1.1.4 Re-upload\bin\PluginFramework.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
