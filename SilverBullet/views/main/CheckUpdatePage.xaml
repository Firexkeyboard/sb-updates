<Page x:Class="OpenBullet.Views.Main.CheckUpdatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Check For Update">

    <Grid Background="{DynamicResource BackgroundMain}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,24,28,24" MaxWidth="820" HorizontalAlignment="Left">

                <!-- Title -->
                <TextBlock Text="SilverBullet Updater"
                           FontSize="20" FontWeight="Bold"
                           Foreground="{DynamicResource ForegroundMain}"
                           Margin="0,0,0,6"/>
                <TextBlock Text="Check for new versions and read the latest release notes."
                           FontSize="12" Foreground="#888"
                           Margin="0,0,0,22"/>

                <!-- Version card -->
                <Border BorderBrush="#2C2C2C" BorderThickness="1"
                        CornerRadius="4" Padding="18,14" Margin="0,0,0,12"
                        Background="{DynamicResource BackgroundSecondary}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="INSTALLED" Foreground="#666"
                                       FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock x:Name="lblCurrentVersion"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="{DynamicResource ForegroundMain}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <TextBlock Text="LATEST" Foreground="#666"
                                       FontSize="10" FontWeight="Bold"
                                       HorizontalAlignment="Right" Margin="0,0,0,5"/>
                            <TextBlock x:Name="lblLatestVersion"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="#555" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Status bar -->
                <Border x:Name="statusBorder" BorderBrush="#2C2C2C" BorderThickness="1"
                        CornerRadius="4" Padding="14,9" Margin="0,0,0,16"
                        Background="{DynamicResource BackgroundSecondary}">
                    <TextBlock x:Name="lblStatus"
                               Text="Press 'Check for Updates' to check."
                               Foreground="#888" FontSize="12"/>
                </Border>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,26">
                    <Button x:Name="btnCheck" Content="Check for Updates"
                            Padding="16,8" FontSize="12"
                            Click="CheckForUpdate_Click" Margin="0,0,10,0"/>
                    <Button x:Name="runUpdaterButton" Content="Download Update"
                            Padding="16,8" FontSize="12" IsEnabled="False"
                            Click="RunUpdater_Click"/>
                </StackPanel>

                <!-- Release Notes section -->
                <TextBlock Text="Release Notes"
                           FontSize="13" FontWeight="Bold"
                           Foreground="{DynamicResource ForegroundMain}"
                           Margin="0,0,0,8"/>
                <Border BorderBrush="#2C2C2C" BorderThickness="1"
                        CornerRadius="4" MinHeight="180" Padding="14"
                        Background="{DynamicResource BackgroundSecondary}">
                    <RichTextBox x:Name="richTextBox"
                                 Background="Transparent"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 Foreground="{DynamicResource ForegroundMain}"
                                 VerticalScrollBarVisibility="Auto"
                                 FontSize="12"/>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
