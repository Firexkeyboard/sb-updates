<Page x:Class="OpenBullet.Views.Main.Help"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Help">

    <Grid Background="{DynamicResource BackgroundMain}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top nav -->
        <DockPanel x:Name="topMenu" Grid.Row="0"
                   Background="{DynamicResource BackgroundSecondary}"
                   LastChildFill="False" Height="30">
            <Label x:Name="aboutLabel" Content="About"
                   Foreground="{DynamicResource ForegroundMain}"
                   Padding="10,0" Height="30" VerticalContentAlignment="Center"
                   Cursor="Hand"
                   MouseLeftButtonUp="aboutLabel_Click"/>
            <Label x:Name="checkForUpdateLabel" Content="Check For Update"
                   Foreground="{DynamicResource ForegroundMain}"
                   Padding="10,0" Height="30" VerticalContentAlignment="Center"
                   Cursor="Hand"
                   MouseLeftButtonUp="checkForUpdateLabel_MouseLeftButtonUp"/>
        </DockPanel>

        <!-- Content frame -->
        <Frame x:Name="Main" Grid.Row="1"
               NavigationUIVisibility="Hidden"/>
    </Grid>
</Page>
