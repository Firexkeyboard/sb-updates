<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <AssemblyName>SilverBullet</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWPF>True</UseWPF>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputPath>C:\Users\alber\Downloads\SilverBullet_Project\build\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <LangVersion>12.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace />
  </PropertyGroup>

  <!-- Proyectos internos -->
  <ItemGroup>
    <ProjectReference Include="..\RuriLib\RuriLib.csproj" />
  </ItemGroup>

  <!-- WPFToolkit — legacy Microsoft WPF Toolkit, referenced by BAML at runtime (PKT=31bf3856ad364e35) -->
  <ItemGroup>
    <Reference Include="WPFToolkit">
      <HintPath>libs\WPFToolkit.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- EO.WebBrowser — signed originals (PKT=e92353a6bf73fffc) required by embedded BAML -->
  <ItemGroup>
    <Reference Include="EO.WebBrowser.Wpf">
      <HintPath>libs\EO.WebBrowser.Wpf.dll</HintPath>
    </Reference>
    <Reference Include="EO.WebBrowser">
      <HintPath>libs\EO.WebBrowser.dll</HintPath>
    </Reference>
    <Reference Include="EO.Base">
      <HintPath>libs\EO.Base.dll</HintPath>
    </Reference>
    <Reference Include="EO.WebEngine">
      <HintPath>libs\EO.WebEngine.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Restore signed EO DLLs after publish (dotnet publish overwrites them with unsigned NuGet versions) -->
  <Target Name="RestoreSignedEoDlls" AfterTargets="Publish">
    <Copy SourceFiles="libs\EO.WebBrowser.Wpf.dll" DestinationFolder="$(PublishDir)" OverwriteReadOnlyFiles="true" />
    <Copy SourceFiles="libs\EO.WebBrowser.dll"     DestinationFolder="$(PublishDir)" OverwriteReadOnlyFiles="true" />
    <Copy SourceFiles="libs\EO.Base.dll"           DestinationFolder="$(PublishDir)" OverwriteReadOnlyFiles="true" />
    <Copy SourceFiles="libs\EO.WebEngine.dll"      DestinationFolder="$(PublishDir)" OverwriteReadOnlyFiles="true" />
  </Target>

  <!-- NuGet: UI / WPF -->
  <ItemGroup>
    <PackageReference Include="MahApps.Metro" Version="2.4.9" />
    <PackageReference Include="MahApps.Metro.IconPacks.FontAwesome" Version="4.11.0" />
    <PackageReference Include="MahApps.Metro.IconPacks.Material" Version="4.11.0" />
    <PackageReference Include="MahApps.Metro.IconPacks.Ionicons" Version="4.11.0" />
    <PackageReference Include="MahApps.Metro.IconPacks.Core" Version="4.11.0" />
    <PackageReference Include="MaterialDesignThemes" Version="4.9.0" />
    <!-- Xceed via HintPath: el BAML embebido referencia la firma original (PKT=3e4669d2f30244f4) -->
    <!-- Si se usara el NuGet package se genera Xceed.Wpf.Toolkit.NET5.dll (PKT diferente) →
         colisión de tipos entre BAML (viejo) y código compilado (nuevo) → InvalidCastException. -->

    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="LiteDB" Version="5.0.17" />
    <PackageReference Include="AngleSharp" Version="1.1.2" />
    <PackageReference Include="CaptchaSharp" Version="1.0.13" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
  </ItemGroup>

  <!-- DLLs sin equivalente NuGet compatible -->
  <ItemGroup>
    <Reference Include="PluginFramework">
      <HintPath>..\..\Telegram Desktop\SilverBullet.v1.1.4 Re-upload\SilverBullet.v1.1.4 Re-upload\bin\PluginFramework.dll</HintPath>
    </Reference>
    <Reference Include="Xceed.Wpf.Toolkit">
      <HintPath>..\build\Xceed.Wpf.Toolkit.dll</HintPath>
    </Reference>
  </ItemGroup>

